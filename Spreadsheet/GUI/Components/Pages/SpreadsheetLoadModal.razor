@namespace GUI.Components.Pages

<div class="overlay @(IsOpen ? "open" : string.Empty)" @onclick="OnCancel">
    <div class="modal-box" @onclick:stopPropagation="true">
        <div class="modal-head">
            <h2>Open Document</h2>
            <button class="icon-btn modal-close" @onclick="OnCancel">×</button>
        </div>
        <div class="modal-body">
            <label class="modal-label">Saved in local storage</label>
            <SpreadsheetFileRowSelector
                Rows="@LocalDocumentRows"
                SelectedName="@SelectedLocalDocumentName"
                EmptyText="No locally saved spreadsheets yet."
                ShowDelete="true"
                OnSelect="OnSelectLocalDocument"
                OnDelete="OnDeleteLocalDocument" />

            <label class="modal-label">Or load from a JSON file</label>
            <InputFile OnChange="OnUploadFile" accept=".json,application/json" />
        </div>
        <div class="modal-foot">
            <button class="btn" @onclick="OnCancel">Cancel</button>
            <button class="btn primary" @onclick="OnOpenSelected">Open Selected</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public IReadOnlyList<LocalDocument> LocalDocuments { get; set; } = [];
    [Parameter] public string? SelectedLocalDocumentName { get; set; }
    [Parameter] public EventCallback<string> OnSelectLocalDocument { get; set; }
    [Parameter] public EventCallback<string> OnDeleteLocalDocument { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnUploadFile { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnOpenSelected { get; set; }

    private IReadOnlyList<FileRowOption> LocalDocumentRows => LocalDocuments
        .Select(document => new FileRowOption(document.Name, document.SavedAtText))
        .ToList();
}

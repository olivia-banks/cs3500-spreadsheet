@namespace GUI.Components.Pages
@page "/"
@page "/sheets"
@rendermode InteractiveServer

<PageTitle>BMOS - BMO Spreadsheeting</PageTitle>

<div class="bmos-shell" tabindex="0" @onclick="CloseMenus">
    <SpreadsheetTitleBar
        DocumentName="@DocumentName"
        IsSaved="@IsSaved"
        OnDocumentNameChanged="OnDocumentNameChanged"
        OnToggleAI="ToggleAI"
        OnOpenAbout="() => OpenModal(ModalKind.About)" />

    <SpreadsheetMenuBar
        OpenMenuName="@OpenMenuName"
        ToggleMenu="ToggleMenu"
        OnNewDocument="NewDocument"
        OnOpenLoad="() => OpenModal(ModalKind.Load)"
        OnOpenSave="() => OpenModal(ModalKind.Save)"
        OnOpenAbout="() => OpenModal(ModalKind.About)"
        OnClearSelectedCell="ClearSelectedCell"
        OnToggleAI="ToggleAI"
        OnZoomIn="ZoomIn"
        OnZoomOut="ZoomOut"
        OnResetZoom="ResetZoom"
        OnOpenAIHelp="OpenAIHelp" />

    <SpreadsheetToolbar
        ZoomPercentText="@ZoomPercentText"
        OnOpenDemo="() => OpenModal(ModalKind.Demo)"
        OnOpenSave="() => OpenModal(ModalKind.Save)"
        OnOpenLoad="() => OpenModal(ModalKind.Load)"
        OnClearSelectedCell="ClearSelectedCell"
        OnZoomIn="ZoomIn"
        OnZoomOut="ZoomOut" />

    <SpreadsheetFormulaBar
        SelectedCellRef="@SelectedCellRef"
        FormulaInput="@FormulaInput"
        OnFormulaChanged="OnFormulaChanged"
        OnFormulaKeyDown="HandleFormulaKeyDown" />

    <div id="workspace">
        <div id="grid-scroll">
            <div id="grid-inner" style="@ZoomStyle">
                <table id="sheet">
                    <thead>
                        <tr>
                            <th class="corner"></th>
                            @for (var col = 0; col < Cols; col++)
                            {
                                <th class="col-hdr">@ColumnLabel(col)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var row = 0; row < Rows; row++)
                        {
                            var localRow = row;
                            <tr>
                                <td class="row-hdr">@(row + 1)</td>
                                @for (var col = 0; col < Cols; col++)
                                {
                                    var localCol = col;
                                    var isSelected = row == SelectedRow && col == SelectedCol;
                                    var className = isSelected ? "cell selected" : "cell";

                                    <td class="@className"
                                        @onclick:stopPropagation="true"
                                        @onclick="(() => SelectCell(localRow, localCol))"
                                        @ondblclick="(() => StartEdit(localRow, localCol))">
                                        @if (IsEditingCell(row, col))
                                        {
                                            <input class="cell-edit-input"
                                                   value="@EditingValue"
                                                   @oninput="OnEditChanged"
                                                   @onclick:stopPropagation="true"
                                                   @onmousedown:stopPropagation="true"
                                                   @onkeydown="HandleEditKeyDown"
                                                   @onkeydown:stopPropagation="true"
                                                   @onblur="CommitEdit"
                                                   autofocus />
                                        }
                                        else
                                        {
                                            <div class="cell-val">@CellValue(row, col)</div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

        <SpreadsheetAIPanel
            AIHidden="@AIHidden"
            AIPanelStyle="@AIPanelStyle"
            AITyping="@AITyping"
            AIInput="@AIInput"
            CanSendAI="@CanSendAI"
            OnToggleAI="ToggleAI"
            OnAIInputChanged="OnAIInputChanged"
            OnAIKeyDown="HandleAIKeyDown"
            OnSendAI="SendAI">
            @foreach (var message in AIMessages)
            {
                <div class="ai-bubble @(message.IsUser ? "user" : "bot")">
                    @if (!message.IsUser)
                    {
                        <span class="ai-label">Be More</span>
                    }
                    <span class="bubble-text">@message.Text</span>
                </div>
            }
        </SpreadsheetAIPanel>
    </div>

    <SpreadsheetStatusBar
        SelectedCellRef="@SelectedCellRef"
        Editing="@Editing"
        Rows="@Rows"
        Cols="@Cols"
        SelectedCellDisplay="@SelectedCellDisplay"
        LastSavedLabel="@LastSavedLabel" />

    <SpreadsheetSaveModal
        IsOpen="@SaveModalOpen"
        SaveName="@SaveName"
        SaveToLocalStorage="@(SelectedSaveDestination == SaveDestination.LocalStorage)"
        OnSaveNameChanged="OnSaveNameChanged"
        OnSelectLocalStorage="(() => SelectedSaveDestination = SaveDestination.LocalStorage)"
        OnSelectDownload="(() => SelectedSaveDestination = SaveDestination.Download)"
        OnCancel="(() => CloseModal(ModalKind.Save))"
        OnSave="ConfirmSaveAsync" />

    <SpreadsheetLoadModal
        IsOpen="@LoadModalOpen"
        LocalDocuments="@LocalDocuments"
        SelectedLocalDocumentName="@SelectedLocalDocumentName"
        UploadInputKey="@LoadUploadInputKey"
        OnSelectLocalDocument="SelectLocalDocument"
        OnDeleteLocalDocument="DeleteLocalDocumentAsync"
        OnUploadFile="OnUploadSpreadsheetFileAsync"
        OnCancel="(() => CloseModal(ModalKind.Load))"
        OnOpenSelected="ConfirmOpenAsync" />

    <SpreadsheetAboutModal
        IsOpen="@AboutModalOpen"
        OnClose="(() => CloseModal(ModalKind.About))" />

    <SpreadsheetDemoModal
        IsOpen="@DemoModalOpen"
        SampleDocuments="@SampleDocumentRows"
        SelectedSampleName="@SelectedDemoDocumentName"
        OnSelectSample="SelectDemoDocument"
        OnCancel="(() => CloseModal(ModalKind.Demo))"
        OnLoadSelected="ConfirmLoadDemo" />

    <div id="notif" class="@(NotificationVisible ? "show" : string.Empty)">@NotificationMessage</div>
</div>
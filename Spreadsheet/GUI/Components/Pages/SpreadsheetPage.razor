@namespace GUI.Components.Pages
@page "/"
@page "/sheets"
@rendermode InteractiveServer

<PageTitle>BMOS - BMO Spreadsheeting</PageTitle>

<div class="bmos-shell" tabindex="0" @onclick="CloseMenus" @onmouseup="StopResizeAI">
    <SpreadsheetTitleBar
        DocumentName="@DocumentName"
        IsSaved="@IsSaved"
        OnDocumentNameChanged="OnDocumentNameChanged"
        OnToggleAI="ToggleAI"
        OnOpenAbout="() => OpenModal(ModalKind.About)" />

    <SpreadsheetMenuBar
        OpenMenuName="@OpenMenuName"
        ToggleMenu="ToggleMenu"
        OnNewDocument="NewDocument"
        OnOpenLoad="() => OpenModal(ModalKind.Load)"
        OnOpenSave="() => OpenModal(ModalKind.Save)"
        OnOpenAbout="() => OpenModal(ModalKind.About)"
        OnClearSelectedCell="ClearSelectedCell"
        OnToggleAI="ToggleAI"
        OnZoomIn="ZoomIn"
        OnZoomOut="ZoomOut"
        OnResetZoom="ResetZoom"
        OnOpenAIHelp="OpenAIHelp" />

    <SpreadsheetToolbar
        ZoomPercentText="@ZoomPercentText"
        OnOpenSave="() => OpenModal(ModalKind.Save)"
        OnOpenLoad="() => OpenModal(ModalKind.Load)"
        OnClearSelectedCell="ClearSelectedCell"
        OnZoomIn="ZoomIn"
        OnZoomOut="ZoomOut" />

    <SpreadsheetFormulaBar
        SelectedCellRef="@SelectedCellRef"
        FormulaInput="@FormulaInput"
        OnFormulaChanged="OnFormulaChanged"
        OnFormulaKeyDown="HandleFormulaKeyDown" />

    <div id="workspace">
        <div id="grid-scroll">
            <div id="grid-inner" style="@ZoomStyle">
                <table id="sheet">
                    <thead>
                        <tr>
                            <th class="corner"></th>
                            @for (var col = 0; col < Cols; col++)
                            {
                                <th class="col-hdr">@ColumnLabel(col)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var row = 0; row < Rows; row++)
                        {
                            var localRow = row;
                            <tr>
                                <td class="row-hdr">@(row + 1)</td>
                                @for (var col = 0; col < Cols; col++)
                                {
                                    var localCol = col;
                                    var isSelected = row == SelectedRow && col == SelectedCol;
                                    var isFound = IsFindMatch(row, col);
                                    var className = isSelected
                                        ? "cell selected"
                                        : isFound
                                            ? "cell found"
                                            : "cell";

                                    <td class="@className"
                                        @onclick:stopPropagation="true"
                                        @onclick="(() => SelectCell(localRow, localCol))"
                                        @ondblclick="(() => StartEdit(localRow, localCol))">
                                        @if (IsEditingCell(row, col))
                                        {
                                            <input class="cell-edit-input"
                                                   value="@EditingValue"
                                                   @oninput="OnEditChanged"
                                                  @onclick:stopPropagation="true"
                                                  @onmousedown:stopPropagation="true"
                                                   @onkeydown="HandleEditKeyDown"
                                                   @onkeydown:stopPropagation="true"
                                                   @onblur="CommitEdit"
                                                   autofocus />
                                        }
                                        else
                                        {
                                            <div class="cell-val">@CellValue(row, col)</div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="find-bar" class="@(FindVisible ? string.Empty : "off")" @onclick:stopPropagation="true">
                <input id="find-input" type="text" value="@FindQuery" @oninput="OnFindInput" placeholder="Find in sheet..." />
                <span class="find-ct">@FindCountText</span>
                <button class="find-x" @onclick="HideFind">×</button>
            </div>
        </div>

        <SpreadsheetAIPanel
            AIHidden="@AIHidden"
            AIPanelStyle="@AIPanelStyle"
            AITyping="@AITyping"
            AIInput="@AIInput"
            CanSendAI="@CanSendAI"
            OnStartResizeAI="StartResizeAI"
            OnToggleAI="ToggleAI"
            OnAIInputChanged="OnAIInputChanged"
            OnAIKeyDown="HandleAIKeyDown"
            OnSendAI="SendAI">
            @foreach (var message in AIMessages)
            {
                <div class="ai-bubble @(message.IsUser ? "user" : "bot")">
                    @if (!message.IsUser)
                    {
                        <span class="ai-label">BMOS AI</span>
                    }
                    <span class="bubble-text">@message.Text</span>
                </div>
            }
        </SpreadsheetAIPanel>
    </div>

    <SpreadsheetStatusBar
        SelectedCellRef="@SelectedCellRef"
        Editing="@Editing"
        Rows="@Rows"
        Cols="@Cols"
        SelectedCellDisplay="@SelectedCellDisplay"
        LastSavedLabel="@LastSavedLabel" />

    <div class="overlay @(SaveModalOpen ? "open" : string.Empty)" @onclick="(() => CloseModal(ModalKind.Save))">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2>Save Document</h2>
                <button class="modal-close" @onclick="(() => CloseModal(ModalKind.Save))">×</button>
            </div>
            <div class="modal-body">
                <label class="modal-label">Document name</label>
                <input type="text" class="modal-input" value="@SaveName" @oninput="OnSaveNameChanged" />
            </div>
            <div class="modal-foot">
                <button class="btn" @onclick="(() => CloseModal(ModalKind.Save))">Cancel</button>
                <button class="btn primary" @onclick="ConfirmSave">Save</button>
            </div>
        </div>
    </div>

    <div class="overlay @(LoadModalOpen ? "open" : string.Empty)" @onclick="(() => CloseModal(ModalKind.Load))">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2>Open Document</h2>
                <button class="modal-close" @onclick="(() => CloseModal(ModalKind.Load))">×</button>
            </div>
            <div class="modal-body">
                <div class="file-list">
                    @foreach (var file in SampleDocuments)
                    {
                        <div class="file-row" @onclick="(() => OpenSample(file.Name))">
                            <span class="file-icon">[ ]</span>
                            <span class="file-name">@file.Name</span>
                            <span class="file-date">@file.DateText</span>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn" @onclick="(() => CloseModal(ModalKind.Load))">Cancel</button>
                <button class="btn primary" @onclick="ConfirmOpen">Open</button>
            </div>
        </div>
    </div>

    <div class="overlay @(AboutModalOpen ? "open" : string.Empty)" @onclick="(() => CloseModal(ModalKind.About))">
        <div class="modal-box modal-about" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2>BMOS Quick Start</h2>
                <button class="modal-close" @onclick="(() => CloseModal(ModalKind.About))">×</button>
            </div>
            <div class="modal-body">
                <p class="about-lead">BMOS is a spreadsheet workspace for entering values and formulas quickly.</p>
                <div class="feat-list">
                    <div class="feat-item"><div class="feat-dot"></div>Click any cell to select it.</div>
                    <div class="feat-item"><div class="feat-dot"></div>Double-click a cell or press Enter to edit in-place.</div>
                    <div class="feat-item"><div class="feat-dot"></div>Use the formula bar to edit the selected cell and press Enter to commit.</div>
                    <div class="feat-item"><div class="feat-dot"></div>Arrow keys and Tab move between cells.</div>
                    <div class="feat-item"><div class="feat-dot"></div>Delete clears the selected cell.</div>
                    <div class="feat-item"><div class="feat-dot"></div>Use Save in the title/menu/toolbar to mark the sheet as saved.</div>
                    <div class="feat-item"><div class="feat-dot"></div>Open the AI panel for formula guidance; drag its left edge to resize.</div>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn primary" @onclick="(() => CloseModal(ModalKind.About))">Close</button>
            </div>
        </div>
    </div>

    @if (ResizingAI)
    {
        <div class="resize-capture" @onmousemove="ResizeAIPanel" @onmouseup="StopResizeAI" @onmouseleave="StopResizeAI"></div>
    }

    <div id="notif" class="@(NotificationVisible ? "show" : string.Empty)">@NotificationMessage</div>
</div>